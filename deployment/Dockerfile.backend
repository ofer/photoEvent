# Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci
COPY backend/ .
RUN npm run build

# Production
FROM node:20-alpine
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodeapi
USER nodeapi

COPY --from=builder --chown=nodeapi:nodejs /app/dist ./dist
COPY --from=builder --chown=nodeapi:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodeapi:nodejs /app/package.json ./

RUN mkdir -p /app/storage && chown nodeapi:nodejs /app/storage

EXPOSE 4000
ENV PORT=4000

CMD ["node", "dist/index.js"]
